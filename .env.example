# ==============================================================================
# Van50 Environment Configuration Example
# Copy this file to .env and fill in your credentials
# (The .env file is gitignored and will never be committed)
# ==============================================================================

# Gmail Newsletter Ingestion Credentials
# 1. Create your Gmail address (e.g. your_events_email@gmail.com)
# 2. In Google Account settings, go to Security -> 2-Step Verification -> App Passwords
# 3. Create an App Password for 'Mail' and paste the 16-character code below:
NEWSLETTER_GMAIL_USER=your_newsletter_email@gmail.com
NEWSLETTER_GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional IMAP Settings (defaults to imap.gmail.com:993)
NEWSLETTER_IMAP_SERVER=imap.gmail.com
NEWSLETTER_IMAP_PORT=993
NEWSLETTER_IMAP_FOLDER=INBOX

# Optional Outbound Daily Discovery Report Email Settings
# SMTP_USERNAME=your_sender_email@gmail.com
# SMTP_PASSWORD=your_sender_app_password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# NOTIFICATION_EMAIL_TO=curator@example.com
